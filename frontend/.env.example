# File path: frontend/.env.example
#
# Copy to frontend/.env and fill in real values. Never commit .env.
#
# Vite only exposes env vars prefixed with VITE_ to client-side code --
# that prefix is required, not a style choice.

# Supabase project URL and anon (publishable) key -- same project the
# backend's SUPABASE_URL points at. Find both in Supabase dashboard ->
# Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the FastAPI backend. Local dev default shown; set to the
# deployed Render URL in production.
VITE_API_BASE_URL=http://localhost:8000
