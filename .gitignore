# File path: .gitignore

# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# --- uv ---
# uv.lock is intentionally NOT ignored -- commit it for reproducible installs.

# --- Backend-generated artifacts ---
# Raw search results and app logs -- don't commit generated/runtime data.
backend/outputs/*
!backend/outputs/.gitkeep
backend/logs/*
!backend/logs/.gitkeep

# --- Frontend (Node/Vite) ---
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example

# --- Editor/OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db